// libraries/css/stylus/styles.styl

primary-color = #6366f1
border-radius = 8px

card-shadow()
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)

.stylus-card
  background-color #fff
  border-radius border-radius
  padding 20px
  card-shadow()

  h4
    color primary-color
    margin-top 0

  p
    margin-bottom 0
