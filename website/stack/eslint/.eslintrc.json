{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "website/stack/nuxt/.nuxt/**",
    "website/stack/nuxt/.output/**"
  ],
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "extends": ["next/core-web-vitals"],
      "parserOptions": {
        "project": false
      }
    }
  ]
}
